rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================
    // UTILITY FUNCTIONS
    // ===========================
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function userRole() {
      let data = getUserData();
      return data != null ? data.role : null;
    }

    function isEditorialMember() {
      let role = userRole();
      return role == 'Editor' || role == 'Managing Editor' || role == 'Admin';
    }

    function isAdmin() {
      let role = userRole();
      return role == 'Admin';
    }

    function isManagingEditor() {
      let role = userRole();
      return role == 'Managing Editor';
    }

    // ===========================
    // USERS COLLECTION
    // ===========================
    match /users/{userId} {
      allow list: if isEditorialMember();
      allow get: if request.auth.uid == userId 
                 || (isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == userId.lower())
                 || isEditorialMember();
      allow create: if isSignedIn() || isEditorialMember();
      allow update: if request.auth.uid == userId || isEditorialMember();
      allow delete: if isAdmin() || isManagingEditor() || request.auth.uid == userId;
    }

    // ===========================
    // SUBMISSIONS COLLECTION
    // ===========================
    match /submissions/{submissionId} {
      
      // Helper to check ownership/assignment based on provided document data
      function isAuthor(data) {
        return isSignedIn() && (
          request.auth.uid == data.author.id
          || (request.auth.token.email != null && data.author.email != null && request.auth.token.email.lower() == data.author.email.lower())
        );
      }

      function isAssignedReviewer(data) {
        return isSignedIn() && (
          (data.reviewerIds != null && request.auth.uid in data.reviewerIds)
          || (data.invitedReviewerEmails != null && request.auth.token.email != null && request.auth.token.email.lower() in data.invitedReviewerEmails)
        );
      }

      allow get: if resource.data.status == 'Accepted' || isAuthor(resource.data) || isAssignedReviewer(resource.data) || isEditorialMember();
      allow list: if true;
      allow create: if isSignedIn();

      // Loosened Update Rule: Allow if Editorial, Author, or Assigned Reviewer
      allow update: if isEditorialMember() || isAuthor(resource.data) || isAssignedReviewer(resource.data);

      allow delete: if isEditorialMember() || (isAuthor(resource.data) && resource.data.status == 'Submitted');

      match /reviews/{reviewId} {
        function getSubmission() {
          return get(/databases/$(database)/documents/submissions/$(submissionId)).data;
        }

        allow list: if isEditorialMember() || isAuthor(getSubmission());
        allow read: if isEditorialMember() || isAuthor(getSubmission()) || (isSignedIn() && request.auth.uid == resource.data.reviewerId);
        allow create: if isSignedIn();
        allow update, delete: if isEditorialMember();
      }

      match /history/{historyId} {
        allow read, list: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    match /reviewInvitations/{inviteId} {
      allow list: if isEditorialMember();
      allow get: if isEditorialMember() || (isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == resource.data.emailNorm);
      allow create: if isEditorialMember();
      allow update: if isEditorialMember() || (isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == resource.data.emailNorm);
      allow delete: if isAdmin() || isManagingEditor();
    }

    match /notifications/{notificationId} {
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if true;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /volumes/{volumeId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }

    match /editorialBoard/{memberId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }

    match /indexingServices/{serviceId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }

    match /settings/submissionCounter {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }
  }
}