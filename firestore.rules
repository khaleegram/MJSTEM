
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================
    // UTILITY FUNCTIONS
    // ===========================
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function userRole() {
      let data = getUserData();
      return data != null ? data.get('role', 'Author') : 'Author';
    }

    function isEditorialMember() {
      let role = userRole();
      return role == 'Editor' || role == 'Managing Editor' || role == 'Admin';
    }

    function isAdmin() {
      let role = userRole();
      return role == 'Admin';
    }

    // ===========================
    // USERS COLLECTION
    // ===========================
    match /users/{userId} {
      allow list: if isEditorialMember();
      allow get: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // ===========================
    // SUBMISSIONS COLLECTION
    // ===========================
    match /submissions/{submissionId} {
      
      // Public read for accepted papers, otherwise signed in
      allow get, list: if resource.data.status == 'Accepted' || isSignedIn();

      // Broad write access for signed in users to ensure revisions and edits never block
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();

      match /reviews/{reviewId} {
        allow read, list: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn() && isEditorialMember();
      }

      match /history/{historyId} {
        allow read, list: if isSignedIn();
        allow create: if true; // Background tasks
        allow update, delete: if false;
      }
    }

    match /reviewInvitations/{inviteId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && isEditorialMember();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if true;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /volumes/{volumeId} {
      allow read: if true;
      allow write: if isSignedIn() && isEditorialMember();
    }

    match /editorialBoard/{memberId} {
      allow read: if true;
      allow write: if isSignedIn() && isEditorialMember();
    }

    match /indexingServices/{serviceId} {
      allow read: if true;
      allow write: if isSignedIn() && isEditorialMember();
    }

    match /settings/submissionCounter {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() && isEditorialMember();
    }
  }
}
