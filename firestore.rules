rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================
    // UTILITY FUNCTIONS
    // ===========================
    function isSignedIn() {
      return request.auth != null;
    }

    function isServer() {
      return request.auth == null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? getUserData().role 
        : null;
    }

    function isRole(role) {
      let currentRole = userRole();
      return currentRole != null && currentRole == role;
    }

    function isAdmin() {
      return isRole('Admin');
    }

    function isManagingEditor() {
      return isRole('Managing Editor');
    }

    function isEditor() {
      return isRole('Editor');
    }

    function isEditorialMember() {
      return isEditor() || isManagingEditor() || isAdmin();
    }

    function isReviewer() {
      return isRole('Reviewer') || isEditorialMember();
    }

    // ===========================
    // USERS COLLECTION
    // ===========================
    match /users/{userId} {
      allow list: if isEditorialMember();
      
      // Allow users to read their own doc (UID) or their placeholder (Email)
      allow get: if request.auth.uid == userId 
                 || (isSignedIn() && request.auth.token.email.lower() == userId.lower())
                 || isEditorialMember();
      
      // Allow users to create their own doc, or editors to create placeholders
      allow create: if request.auth.uid == userId 
                    || (isSignedIn() && request.auth.token.email.lower() == userId.lower())
                    || isEditorialMember();

      // Loosened update: Allow users to update their profile or editors to manage roles
      allow update: if request.auth.uid == userId || isEditorialMember();

      // Allow users to delete placeholders after migration
      allow delete: if isAdmin() || isManagingEditor() 
                    || (request.auth.uid == userId)
                    || (isSignedIn() && request.auth.token.email.lower() == userId.lower());
    }

    // ===========================
    // SUBMISSIONS COLLECTION
    // ===========================
    match /submissions/{submissionId} {

      allow get: if resource.data.status == 'Accepted' || (isSignedIn() && (
        resource.data.author.id == request.auth.uid
        || (resource.data.author.email != null && request.auth.token.email.lower() == resource.data.author.email.lower())
        || (resource.data.reviewerIds != null && request.auth.uid in resource.data.reviewerIds)
        || isEditorialMember()
        || (resource.data.invitedReviewerEmails != null && request.auth.token.email.lower() in resource.data.invitedReviewerEmails)
      ));

      allow list: if true;
      allow create: if isSignedIn();

      // UN-TIGHTENED RULE: Allow update if the user is associated with the submission
      allow update: if
        isEditorialMember()
        || (isSignedIn() && (
            request.auth.uid == resource.data.author.id 
            || (resource.data.author.email != null && request.auth.token.email.lower() == resource.data.author.email.lower())
            || (resource.data.reviewerIds != null && request.auth.uid in resource.data.reviewerIds)
            || (resource.data.invitedReviewerEmails != null && request.auth.token.email.lower() in resource.data.invitedReviewerEmails)
        ));

      allow delete: if
        (request.auth.uid == resource.data.author.id && resource.data.status == 'Submitted')
        || isEditorialMember();

      match /reviews/{reviewId} {
        allow list: if isEditorialMember() || (isSignedIn() &&
          (get(/databases/$(database)/documents/submissions/$(submissionId)).data.author.id == request.auth.uid || 
           get(/databases/$(database)/documents/submissions/$(submissionId)).data.author.email.lower() == request.auth.token.email.lower()));
        
        allow read: if
          isEditorialMember() ||
          (isSignedIn() &&
            (get(/databases/$(database)/documents/submissions/$(submissionId)).data.author.id == request.auth.uid || 
             get(/databases/$(database)/documents/submissions/$(submissionId)).data.author.email.lower() == request.auth.token.email.lower())) ||
          (isReviewer() && (resource.data.reviewerId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/submissions/$(submissionId)).data.reviewerIds));
        
        allow create: if isSignedIn();
        allow update, delete: if isEditorialMember();
      }

      match /history/{historyId} {
        allow read, list: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    match /reviewInvitations/{inviteId} {
      allow list: if isEditorialMember();
      allow get: if isEditorialMember() || (isSignedIn() && request.auth.token.email.lower() == resource.data.emailNorm);
      allow create: if isEditorialMember();
      allow update: if isEditorialMember();
      allow delete: if isAdmin() || isManagingEditor();
    }

    match /notifications/{notificationId} {
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isServer() || isEditorialMember();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /volumes/{volumeId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }

    match /editorialBoard/{memberId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }

    match /indexingServices/{serviceId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }

    match /settings/submissionCounter {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if (isManagingEditor() || isAdmin()) && settingId != 'submissionCounter';
    }
  }
}