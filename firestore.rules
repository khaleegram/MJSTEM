
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================
    // UTILITY FUNCTIONS
    // ===========================
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function userRole() {
      let data = getUserData();
      return data != null ? data.get('role', 'Author') : 'Author';
    }

    function isEditorialMember() {
      let role = userRole();
      return role == 'Editor' || role == 'Managing Editor' || role == 'Admin';
    }

    function isAdmin() {
      let role = userRole();
      return role == 'Admin';
    }

    // ===========================
    // USERS COLLECTION
    // ===========================
    match /users/{userId} {
      allow list: if isEditorialMember();
      allow get: if isSignedIn() && (
        request.auth.uid == userId 
        || (request.auth.token.get('email', '').lower() == userId.lower())
        || isEditorialMember()
      );
      allow create: if isSignedIn() || isEditorialMember();
      allow update: if isSignedIn() && (request.auth.uid == userId || isEditorialMember());
      allow delete: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
    }

    // ===========================
    // SUBMISSIONS COLLECTION
    // ===========================
    match /submissions/{submissionId} {
      
      function isAuthor(data) {
        let uid = request.auth.uid;
        let email = request.auth.token.get('email', '').lower();
        let authorObj = data.get('author', {});
        let docId = authorObj.get('id', '');
        let docEmail = authorObj.get('email', '').lower();
        
        return isSignedIn() && (uid == docId || (email != '' && email == docEmail));
      }

      function isAssignedReviewer(data) {
        let uid = request.auth.uid;
        let email = request.auth.token.get('email', '').lower();
        let reviewerIds = data.get('reviewerIds', []);
        let invitedEmails = data.get('invitedReviewerEmails', []);
        
        return isSignedIn() && (uid in reviewerIds || (email != '' && email in invitedEmails));
      }

      allow get: if resource.data.status == 'Accepted' 
                 || (isSignedIn() && (isAuthor(resource.data) || isAssignedReviewer(resource.data) || isEditorialMember()));
      
      allow list: if resource.data.status == 'Accepted' || isSignedIn();

      allow create: if isSignedIn();

      allow update: if isSignedIn() && (
        isEditorialMember() 
        || isAuthor(resource.data) 
        || isAssignedReviewer(resource.data)
      );

      allow delete: if isSignedIn() && (isEditorialMember() || (isAuthor(resource.data) && resource.data.status == 'Submitted'));

      match /reviews/{reviewId} {
        function getSubmission() {
          return get(/databases/$(database)/documents/submissions/$(submissionId)).data;
        }

        allow list, read: if (getSubmission().status == 'Accepted') 
                          || (isSignedIn() && (isEditorialMember() || isAuthor(getSubmission()) || request.auth.uid == resource.data.reviewerId));
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && isEditorialMember();
      }

      match /history/{historyId} {
        function getSubmission() {
          return get(/databases/$(database)/documents/submissions/$(submissionId)).data;
        }
        allow read, list: if isSignedIn() && (
          isEditorialMember() 
          || isAuthor(getSubmission()) 
          || isAssignedReviewer(getSubmission())
        );
        allow create: if true; // Background tasks bypass this via Admin SDK, but allowed for robustness
        allow update, delete: if false;
      }
    }

    match /reviewInvitations/{inviteId} {
      allow list: if isSignedIn() && isEditorialMember();
      allow get: if isSignedIn() && (isEditorialMember() || (request.auth.token.email != null && request.auth.token.email.lower() == resource.data.emailNorm));
      allow create: if isSignedIn() && isEditorialMember();
      allow update: if isSignedIn() && (isEditorialMember() || (request.auth.token.email != null && request.auth.token.email.lower() == resource.data.emailNorm));
      allow delete: if isSignedIn() && (isAdmin());
    }

    match /notifications/{notificationId} {
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if true;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /volumes/{volumeId} {
      allow read: if true;
      allow write: if isSignedIn() && isEditorialMember();
    }

    match /editorialBoard/{memberId} {
      allow read: if true;
      allow write: if isSignedIn() && isEditorialMember();
    }

    match /indexingServices/{serviceId} {
      allow read: if true;
      allow write: if isSignedIn() && isEditorialMember();
    }

    match /settings/submissionCounter {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() && isEditorialMember();
    }
  }
}
