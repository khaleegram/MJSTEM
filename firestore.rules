rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================
    // UTILITY FUNCTIONS
    // ===========================
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return hasUserDoc()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isRole(role) {
      return userRole() == role;
    }

    function isAdmin() {
      return isRole('Admin');
    }

    function isManagingEditor() {
      return isRole('Managing Editor');
    }

    function isEditor() {
      return isRole('Editor');
    }

    function isReviewer() {
      return isRole('Reviewer');
    }

    function isAuthor() {
      return isRole('Author');
    }

    function isEditorialMember() {
      return isEditor() || isManagingEditor() || isAdmin();
    }

    function isServer() {
      // Cloud Functions / Admin SDK
      return request.auth == null;
    }

    // ===========================
    // USERS COLLECTION
    // ===========================
    match /users/{userId} {
      allow list: if isSignedIn() || isServer();

      allow get: if isSignedIn() && (
        request.auth.uid == userId ||
        isEditorialMember() ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
        request.auth.uid == userId;

      allow update: if (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data)
          .changedKeys()
          .hasOnly(['displayName', 'photoURL', 'specialization', 'fcmTokens'])
      ) || isAdmin() || isManagingEditor();

      allow delete: if false;
    }

    // ===========================
    // SUBMISSIONS COLLECTION
    // ===========================
    match /submissions/{submissionId} {

      allow list: if isSignedIn();

      allow get: if isSignedIn() && (
        resource.data.author.id == request.auth.uid ||
        (resource.data.reviewerIds != null &&
         request.auth.uid in resource.data.reviewerIds) ||
        isEditorialMember() ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
        request.resource.data.author.id == request.auth.uid;

      allow update: if
        isEditorialMember() ||
        isAdmin() ||
        (
          isAuthor() &&
          request.auth.uid == resource.data.author.id &&
          (
            (
              resource.data.status in [
                'Minor Revision',
                'Major Revision',
                'Awaiting Revision: Similarity Issues'
              ] &&
              request.resource.data.diff(resource.data)
                .changedKeys()
                .hasOnly([
                  'manuscriptUrl',
                  'status',
                  'revision',
                  'originalManuscriptUrl',
                  'pageCount'
                ])
            ) ||
            (
              resource.data.status != 'Accepted' &&
              resource.data.status != 'Rejected' &&
              request.resource.data.diff(resource.data)
                .changedKeys()
                .hasOnly(['title', 'abstract'])
            )
          )
        );

      allow delete: if
        (isAuthor() &&
         resource.data.author.id == request.auth.uid &&
         resource.data.status == 'Submitted')
        || isEditorialMember()
        || isAdmin();

      // ---------------------------
      // REVIEWS SUBCOLLECTION
      // ---------------------------
      match /reviews/{reviewId} {

        allow list: if isEditorialMember() || isAdmin() ||
          (isAuthor() && request.auth.uid == get(/databases/$(database)/documents/submissions/$(submissionId)).data.author.id);

        allow get: if
          isEditorialMember() ||
          isAdmin() ||
          (
            isReviewer() &&
            get(/databases/$(database)/documents/submissions/$(submissionId))
              .data.reviewerIds != null &&
            request.auth.uid in
              get(/databases/$(database)/documents/submissions/$(submissionId))
                .data.reviewerIds
          ) ||
          (
            isAuthor() &&
            request.auth.uid ==
              get(/databases/$(database)/documents/submissions/$(submissionId))
                .data.author.id
          );

        allow create: if isSignedIn() && (
          (
            isReviewer() &&
            get(/databases/$(database)/documents/submissions/$(submissionId))
              .data.reviewerIds != null &&
            request.auth.uid in
              get(/databases/$(database)/documents/submissions/$(submissionId))
                .data.reviewerIds
          ) ||
          isEditorialMember() ||
          isAdmin()
        );

        allow update, delete: if false;
      }

      // ---------------------------
      // HISTORY SUBCOLLECTION
      // ---------------------------
      match /history/{historyId} {

        allow list: if
          isEditorialMember() ||
          isAdmin() ||
          (
            isAuthor() &&
            request.auth.uid ==
              get(/databases/$(database)/documents/submissions/$(submissionId))
                .data.author.id
          );

        allow get: if
          isEditorialMember() ||
          isAdmin() ||
          (
            isAuthor() &&
            request.auth.uid ==
              get(/databases/$(database)/documents/submissions/$(submissionId))
                .data.author.id
          ) ||
          (
            isReviewer() &&
            request.auth.uid in
              get(/databases/$(database)/documents/submissions/$(submissionId))
                .data.reviewerIds
          );

        allow create: if isServer() || isEditorialMember() || isAdmin();
        allow update, delete: if false;
      }
    }

    // ===========================
    // NOTIFICATIONS COLLECTION
    // ===========================
    match /notifications/{notificationId} {

      // Users can query, Firestore filters per document
      allow list: if isSignedIn();

      // Only owner can read a notification
      allow get: if isSignedIn() &&
        resource.data.userId == request.auth.uid;

      // Only backend or editorial/admin can create
      allow create: if isServer() || isEditorialMember() || isAdmin();

      // User can only mark as read
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['read']);

      allow delete: if false;
    }

    // ===========================
    // VOLUMES
    // ===========================
    match /volumes/{volumeId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }

    // ===========================
    // EDITORIAL BOARD
    // ===========================
    match /editorialBoard/{memberId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }

    // ===========================
    // INDEXING SERVICES
    // ===========================
    match /indexingServices/{serviceId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }

    // ===========================
    // SETTINGS
    // ===========================
    match /settings/submissionCounter {
      allow read: if true;
      allow write: if isServer();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if
        (isManagingEditor() || isAdmin()) &&
        settingId != 'submissionCounter';
    }
  }
}