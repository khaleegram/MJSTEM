rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================
    // UTILITY FUNCTIONS
    // ===========================
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? getUserData().role 
        : null;
    }

    function isAdmin() {
      let role = userRole();
      return role == 'Admin';
    }

    function isManagingEditor() {
      let role = userRole();
      return role == 'Managing Editor';
    }

    function isEditor() {
      let role = userRole();
      return role == 'Editor';
    }

    function isEditorialMember() {
      let role = userRole();
      return role == 'Editor' || role == 'Managing Editor' || role == 'Admin';
    }

    // ===========================
    // USERS COLLECTION
    // ===========================
    match /users/{userId} {
      allow list: if isEditorialMember();
      allow get: if request.auth.uid == userId 
                 || (isSignedIn() && request.auth.token.email.lower() == userId.lower())
                 || isEditorialMember();
      allow create: if isSignedIn();
      allow update: if request.auth.uid == userId || isEditorialMember();
      allow delete: if isAdmin() || isManagingEditor() || request.auth.uid == userId;
    }

    // ===========================
    // SUBMISSIONS COLLECTION
    // ===========================
    match /submissions/{submissionId} {
      
      // Ownership check: Match by UID or Email
      function isAuthor() {
        return isSignedIn() && (
          request.auth.uid == resource.data.author.id
          || (request.auth.token.email != null && resource.data.author.email != null && request.auth.token.email.lower() == resource.data.author.email.lower())
        );
      }

      function isAssignedReviewer() {
        return isSignedIn() && (
          (resource.data.reviewerIds != null && request.auth.uid in resource.data.reviewerIds)
          || (resource.data.invitedReviewerEmails != null && request.auth.token.email != null && request.auth.token.email.lower() in resource.data.invitedReviewerEmails)
        );
      }

      allow get: if resource.data.status == 'Accepted' || isAuthor() || isAssignedReviewer() || isEditorialMember();
      allow list: if true;
      allow create: if isSignedIn();

      // Loosened Update Rule: Allow if Editorial, Author, or Assigned Reviewer
      allow update: if isEditorialMember() || isAuthor() || isAssignedReviewer();

      allow delete: if isEditorialMember() || (isAuthor() && resource.data.status == 'Submitted');

      match /reviews/{reviewId} {
        allow list: if isEditorialMember() || isAuthor();
        allow read: if isEditorialMember() || isAuthor() || (isSignedIn() && request.auth.uid == resource.data.reviewerId);
        allow create: if isSignedIn();
        allow update, delete: if isEditorialMember();
      }

      match /history/{historyId} {
        allow read, list: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    match /reviewInvitations/{inviteId} {
      allow list: if isEditorialMember();
      allow get: if isEditorialMember() || (isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == resource.data.emailNorm);
      allow create: if isEditorialMember();
      allow update: if isEditorialMember() || (isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == resource.data.emailNorm);
      allow delete: if isAdmin() || isManagingEditor();
    }

    match /notifications/{notificationId} {
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if true; // Allow system-generated notifications
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /volumes/{volumeId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }

    match /editorialBoard/{memberId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }

    match /indexingServices/{serviceId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }

    match /settings/submissionCounter {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }
  }
}