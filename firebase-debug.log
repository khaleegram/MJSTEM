[debug] [2026-02-28T10:20:29.200Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/mjstem-7b45a/rulesets {"name":"projects/mjstem-7b45a/rulesets/29a7d558-6ca1-4958-83d1-f8e2fb00d87a","source":{"files":[{"content":"\r\nrules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // ---------------------------\n    // Common helpers\n    // ---------------------------\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function authUid() {\n      return request.auth.uid;\n    }\n\n    function authEmail() {\n      return isSignedIn() && request.auth.token.email is string\n        ? request.auth.token.email\n        : null;\n    }\n\n    function currentUserDocPath() {\n      return /databases/$(database)/documents/users/$(authUid());\n    }\n\n    function currentUserData() {\n      return isSignedIn() && exists(currentUserDocPath())\n        ? get(currentUserDocPath()).data\n        : null;\n    }\n\n    function currentUserRole() {\n      let data = currentUserData();\n      return data != null && data.role is string ? data.role : 'Author';\n    }\n\n    function isEditorialMember() {\n      return isSignedIn() &&\n        (currentUserRole() == 'Editor' ||\n         currentUserRole() == 'Managing Editor' ||\n         currentUserRole() == 'Admin');\n    }\n\n    function isRoleManager() {\n      return isSignedIn() &&\n        (currentUserRole() == 'Managing Editor' || currentUserRole() == 'Admin');\n    }\n\n    function isOwnUserDoc(userId) {\n      return isSignedIn() && userId == authUid();\n    }\n\n    function isOwnEmailDoc(userId) {\n      return isSignedIn() && authEmail() != null && userId == authEmail();\n    }\n\n    // ---------------------------\n    // Submission helpers\n    // ---------------------------\n    function hasAuthor(data) {\n      return data != null && data.author is map && data.author.id is string;\n    }\n\n    function isSubmissionAuthor(data) {\n      return hasAuthor(data) && isSignedIn() && data.author.id == authUid();\n    }\n\n    function isAssignedReviewer(data) {\n      return data != null && isSignedIn() && (\n        (data.reviewerIds is list && authUid() in data.reviewerIds) ||\n        (authEmail() != null &&\n          data.invitedReviewerEmails is list &&\n          authEmail() in data.invitedReviewerEmails)\n      );\n    }\n\n    function canReadSubmission(data) {\n      return data != null && (\n        data.status == 'Accepted' ||\n        isEditorialMember() ||\n        isSubmissionAuthor(data) ||\n        isAssignedReviewer(data)\n      );\n    }\n\n    function canReadSubmissionAsParticipant(data) {\n      return data != null && (\n        isEditorialMember() ||\n        isSubmissionAuthor(data) ||\n        isAssignedReviewer(data)\n      );\n    }\n\n    function authorCanCreateSubmission() {\n      return isSignedIn() &&\n        request.resource.data.author is map &&\n        request.resource.data.author.id == authUid() &&\n        request.resource.data.status == 'Submitted';\n    }\n\n    function authorStatusAndRevisionValid() {\n      let oldRevision = resource.data.revision is int ? resource.data.revision : 0;\n      let statusChanged = request.resource.data.status != resource.data.status;\n      let revisionChanged = request.resource.data.revision != resource.data.revision;\n\n      return (!statusChanged && !revisionChanged) || (\n        resource.data.status in [\n          'Minor Revision',\n          'Major Revision',\n          'Awaiting Revision: Similarity Issues'\n        ] &&\n        request.resource.data.status in ['Under Review-R1', 'Under Review-R2'] &&\n        request.resource.data.revision is int &&\n        request.resource.data.revision == oldRevision + 1\n      );\n    }\n\n    function authorCanUpdateSubmission() {\n      return isSubmissionAuthor(resource.data) &&\n        request.resource.data.diff(resource.data).changedKeys().hasOnly([\n          'title',\n          'abstract',\n          'keywords',\n          'manuscriptUrl',\n          'supplementaryFileUrl',\n          'contributors',\n          'pageCount',\n          'status',\n          'revision',\n          'originalManuscriptUrl',\n          'revisionManuscripts'\n        ]) &&\n        authorStatusAndRevisionValid();\n    }\n\n    function reviewerCanUpdateSubmission() {\n      return isAssignedReviewer(resource.data) &&\n        request.resource.data.diff(resource.data).changedKeys().hasOnly([\n          'reviewers',\n          'reviewerIds',\n          'invitedReviewerEmails'\n        ]);\n    }\n\n    // ---------------------------\n    // users\n    // ---------------------------\n    match /users/{userId} {\n      allow get: if isEditorialMember() || isOwnUserDoc(userId) || isOwnEmailDoc(userId);\n\n      allow list: if isEditorialMember() || (\n        isSignedIn() && (\n          (resource.data.uid is string && resource.data.uid == authUid()) ||\n          (authEmail() != null &&\n            resource.data.email is string &&\n            resource.data.email == authEmail())\n        )\n      );\n\n      // Own UID doc (normal signup/login) or editorial-created placeholders.\n      allow create: if (isOwnUserDoc(userId) && request.resource.data.uid == authUid()) ||\n        isEditorialMember();\n\n      // Role changes are restricted to role managers.\n      allow update: if isRoleManager() || (\n        isOwnUserDoc(userId) &&\n        request.resource.data.uid == resource.data.uid &&\n        request.resource.data.role == resource.data.role\n      );\n\n      // Allow own UID doc deletion, role-manager deletion, or own placeholder cleanup.\n      allow delete: if isRoleManager() ||\n        isOwnUserDoc(userId) ||\n        (\n          isSignedIn() &&\n          resource.data.isPlaceholder == true &&\n          authEmail() != null &&\n          resource.data.email is string &&\n          resource.data.email == authEmail()\n        );\n    }\n\n    // ---------------------------\n    // submissions\n    // ---------------------------\n    match /submissions/{submissionId} {\n      allow get: if canReadSubmission(resource.data);\n\n      // Split list rules explicitly; this is friendlier to Firestore query evaluation.\n      allow list: if resource.data.status == 'Accepted';\n      allow list: if isEditorialMember();\n      allow list: if isSubmissionAuthor(resource.data);\n      allow list: if isSignedIn() &&\n        resource.data.reviewerIds is list &&\n        authUid() in resource.data.reviewerIds;\n      allow list: if isSignedIn() &&\n        authEmail() != null &&\n        resource.data.invitedReviewerEmails is list &&\n        authEmail() in resource.data.invitedReviewerEmails;\n\n      allow create: if isEditorialMember() || authorCanCreateSubmission();\n\n      allow update: if isEditorialMember() ||\n        authorCanUpdateSubmission() ||\n        reviewerCanUpdateSubmission();\n\n      allow delete: if isEditorialMember() ||\n        (isSubmissionAuthor(resource.data) && resource.data.status == 'Submitted');\n\n      match /reviews/{reviewId} {\n        function parentSubmission() {\n          return get(/databases/$(database)/documents/submissions/$(submissionId)).data;\n        }\n\n        allow get, list: if isSignedIn() && canReadSubmissionAsParticipant(parentSubmission());\n\n        allow create: if isSignedIn() &&\n          isAssignedReviewer(parentSubmission()) &&\n          request.resource.data.reviewerId == authUid();\n\n        allow update: if isEditorialMember() || (\n          isSignedIn() &&\n          resource.data.reviewerId == authUid() &&\n          request.resource.data.reviewerId == authUid()\n        );\n\n        allow delete: if isEditorialMember();\n      }\n\n      match /history/{historyId} {\n        function parentSubmission() {\n          return get(/databases/$(database)/documents/submissions/$(submissionId)).data;\n        }\n\n        allow get, list: if isSignedIn() && canReadSubmissionAsParticipant(parentSubmission());\n\n        // History is written by trusted server flows (Admin SDK bypasses rules).\n        allow create: if false;\n        allow update, delete: if false;\n      }\n    }\n\n    // ---------------------------\n    // reviewer invitations\n    // ---------------------------\n    match /reviewInvitations/{inviteId} {\n      allow get, list, create, update, delete: if isEditorialMember();\n    }\n\n    // ---------------------------\n    // notifications\n    // ---------------------------\n    match /notifications/{notificationId} {\n      allow get, list: if isSignedIn() && resource.data.userId == authUid();\n\n      allow update: if isSignedIn() &&\n        resource.data.userId == authUid() &&\n        request.resource.data.userId == resource.data.userId &&\n        request.resource.data.diff(resource.data).changedKeys().hasOnly(['read']);\n\n      // Created by trusted server flows.\n      allow create: if false;\n      allow delete: if false;\n    }\n\n    // ---------------------------\n    // publication/public content\n    // ---------------------------\n    match /volumes/{volumeId} {\n      allow read: if true;\n      allow write: if isEditorialMember();\n    }\n\n    match /editorialBoard/{memberId} {\n      allow read: if true;\n      allow write: if isEditorialMember();\n    }\n\n    match /indexingServices/{serviceId} {\n      allow read: if true;\n      allow write: if isRoleManager();\n    }\n\n    // ---------------------------\n    // settings\n    // ---------------------------\n    // Used by client-side submission ID generation in current app flow.\n    match /settings/submissionCounter {\n      allow read, write: if isSignedIn();\n    }\n\n    match /settings/{settingId} {\n      allow read: if true;\n      allow write: if isRoleManager();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-02-28T10:20:27.862111Z","metadata":{"services":["cloud.firestore"]}}
