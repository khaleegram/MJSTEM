
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function userDoc() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function role() {
      // If user doc missing, role is null (prevents rule crashes)
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? userDoc().role
        : null;
    }

    function isEditorial() {
      return role() in ['Editor', 'Managing Editor', 'Admin'];
    }

    function isAdmin() { return role() == 'Admin'; }
    function isManagingEditor() { return role() == 'Managing Editor'; }
    function isReviewer() { return role() == 'Reviewer'; }
    function isAuthor() { return role() == 'Author'; }

    // ---------------------------
    // USERS
    // ---------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isEditorial());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isEditorial());
      allow delete: if false;
      allow list: if isEditorial();
    }

    // ---------------------------
    // SUBMISSIONS
    // ---------------------------
    match /submissions/{submissionId} {

      // Public listing allowed (search feed etc.)
      allow list: if true;

      // Public can read Accepted; otherwise involved users + editorial
      allow get: if resource.data.status == 'Accepted'
        || (isSignedIn() && (
          resource.data.author.id == request.auth.uid
          || (resource.data.reviewerIds != null && request.auth.uid in resource.data.reviewerIds)
          || isEditorial()
        ));

      // Minimal create: any signed-in user can create for themselves
      allow create: if isSignedIn()
        && request.resource.data.author.id == request.auth.uid;

      // Minimal update: editorial can update anything; authors can update their own; reviewers involved can update
      allow update: if isSignedIn() && (
        isEditorial()
        || resource.data.author.id == request.auth.uid
        || (resource.data.reviewerIds != null && request.auth.uid in resource.data.reviewerIds)
      );

      // Minimal delete: author can delete if Submitted; editorial can delete anything
      allow delete: if isSignedIn() && (
        isEditorial()
        || (resource.data.author.id == request.auth.uid && resource.data.status == 'Submitted')
      );

      // Reviews subcollection
      match /reviews/{reviewId} {
        allow read, list: if isSignedIn() && (
          isEditorial()
          || get(/databases/$(database)/documents/submissions/$(submissionId)).data.author.id == request.auth.uid
          || (isReviewer() && resource.data.reviewerId == request.auth.uid)
        );

        // Minimal create: assigned reviewers + editorial
        allow create: if isSignedIn() && (
          isEditorial()
          || (isReviewer() && request.auth.uid in get(/databases/$(database)/documents/submissions/$(submissionId)).data.reviewerIds)
        );

        allow update, delete: if false;
      }

      // History subcollection
      match /history/{historyId} {
        allow read, list: if isSignedIn() && (
          isEditorial()
          || get(/databases/$(database)/documents/submissions/$(submissionId)).data.author.id == request.auth.uid
          || (get(/databases/$(database)/documents/submissions/$(submissionId)).data.reviewerIds != null
              && request.auth.uid in get(/databases/$(database)/documents/submissions/$(submissionId)).data.reviewerIds)
        );

        // Create only by editorial (do NOT use "isServer" in rules)
        allow create: if isEditorial();
        allow update, delete: if false;
      }
    }

    // ---------------------------
    // INVITATIONS (PATCHED)
    // ---------------------------
    match /invitations/{invitationId} {
      // Never allow listing invitations
      allow list: if false;

      // Anyone can GET a single invitation by ID (link-only access)
      // Keep invitation docs non-sensitive and make invitationId unguessable.
      allow get: if true;

      // Only editorial can create/update/delete invitations
      allow create, update, delete: if isEditorial();
    }

    // ---------------------------
    // NOTIFICATIONS
    // ---------------------------
    match /notifications/{notificationId} {
      allow read, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isEditorial();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ---------------------------
    // PUBLIC SETTINGS / CONTENT
    // ---------------------------
    match /volumes/{volumeId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }

    match /editorialBoard/{memberId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }

    match /indexingServices/{serviceId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }

    match /settings/submissionCounter {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if (isManagingEditor() || isAdmin()) && settingId != 'submissionCounter';
    }
  }
}
