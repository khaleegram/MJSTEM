
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===========================
    // PERMISSIVE MODE: UNBLOCK DEVELOPMENT
    // ===========================
    // Allows any authenticated user to perform any operation.
    // This resolves ownership mismatches and complex rule failures.
    
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Special case for public reading of accepted articles and journal info
    match /submissions/{submissionId} {
      allow read: if true;
    }
    match /volumes/{volumeId} {
      allow read: if true;
    }
    match /editorialBoard/{memberId} {
      allow read: if true;
    }
    match /indexingServices/{serviceId} {
      allow read: if true;
    }
    match /settings/{settingId} {
      allow read: if true;
    }
  }
}
