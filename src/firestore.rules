
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------
    // UTILITY FUNCTIONS
    // ---------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return isSignedIn() && hasUserDoc()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isRole(role) {
      return userRole() == role;
    }

    function isAdmin() {
      return isRole('Admin');
    }

    function isManagingEditor() {
      return isRole('Managing Editor');
    }

    function isEditor() {
      return isRole('Editor');
    }

    function isReviewer() {
      return isRole('Reviewer');
    }

    function isAuthor() {
      return isRole('Author');
    }

    function isEditorialMember() {
      return isEditor() || isManagingEditor() || isAdmin();
    }

    function isServer() {
      return request.auth == null;
    }

    // ---------------------------
    // USERS COLLECTION
    // ---------------------------
    match /users/{userId} {
      allow list: if isSignedIn() || isServer();
      allow read: if request.auth.uid == userId || isEditorialMember() || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if (
        (isSignedIn() && request.auth.uid == userId &&
         request.resource.data.diff(resource.data).changedKeys()
           .hasOnly(['displayName', 'photoURL', 'specialization', 'fcmTokens']))
        || isAdmin() || isManagingEditor()
      );
    }

    // ---------------------------
    // SUBMISSIONS COLLECTION
    // ---------------------------
    match /submissions/{submissionId} {

      allow list: if isEditorialMember() || isAdmin() || isAuthor() || isReviewer();

      allow get: if isSignedIn() && (
        resource.data.author.id == request.auth.uid ||
        (resource.data.reviewerIds != null &&
         request.auth.uid in resource.data.reviewerIds) ||
        isEditorialMember() || isAdmin()
      );

      allow create: if isSignedIn() &&
        request.resource.data.author.id == request.auth.uid;

      allow update: if isEditorialMember() || isAdmin() || (
        isAuthor() && request.auth.uid == resource.data.author.id && (
            // Allow revision uploads
            (resource.data.status in ['Minor Revision', 'Major Revision', 'Awaiting Revision: Similarity Issues'] &&
             request.resource.data.diff(resource.data).changedKeys().hasOnly(['manuscriptUrl', 'status', 'revision', 'originalManuscriptUrl', 'pageCount'])) ||
            // Allow title/abstract edits before final decision
            (resource.data.status != 'Accepted' && resource.data.status != 'Rejected' &&
             request.resource.data.diff(resource.data).changedKeys().hasOnly(['title', 'abstract']))
        )
      );

      allow delete: if (isAuthor() && resource.data.author.id == request.auth.uid && resource.data.status == 'Submitted') || isEditorialMember() || isAdmin();

      // ---------------------------
      // REVIEWS SUBCOLLECTION
      // ---------------------------
      match /reviews/{reviewId} {

        allow list: if isEditorialMember() || isAdmin();

        allow read: if
          isEditorialMember() || isAdmin() ||
          (
            isReviewer() &&
            get(/databases/$(database)/documents/submissions/$(submissionId))
              .data.reviewerIds != null &&
            request.auth.uid in
              get(/databases/$(database)/documents/submissions/$(submissionId))
                .data.reviewerIds
          ) ||
          (
            isAuthor() &&
            request.auth.uid ==
              get(/databases/$(database)/documents/submissions/$(submissionId))
                .data.author.id
          );

        allow create: if
          isSignedIn() &&
          (
            (
              isReviewer() &&
              get(/databases/$(database)/documents/submissions/$(submissionId))
                .data.reviewerIds != null &&
              request.auth.uid in
                get(/databases/$(database)/documents/submissions/$(submissionId))
                  .data.reviewerIds
            )
            || isEditorialMember()
            || isAdmin()
          );

        allow update, delete: if false;
      }

      // ---------------------------
      // HISTORY SUBCOLLECTION
      // ---------------------------
      match /history/{historyId} {

        allow list: if isEditorialMember() || isAdmin() ||
          (
            isAuthor() &&
            request.auth.uid ==
              get(/databases/$(database)/documents/submissions/$(submissionId))
                .data.author.id
          );

        allow read: if isEditorialMember() || isAdmin() ||
          (
            isAuthor() &&
            request.auth.uid ==
              get(/databases/$(database)/documents/submissions/$(submissionId))
                .data.author.id
          ) ||
          (
            isReviewer() &&
            request.auth.uid in
              get(/databases/$(database)/documents/submissions/$(submissionId))
                .data.reviewerIds
          );

        allow create: if isServer() || isEditorialMember() || isAdmin();
        allow update, delete: if false;
      }
    }

    // ---------------------------
    // NOTIFICATIONS COLLECTION
    // ---------------------------
    match /notifications/{notificationId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow create: if isServer() || isEditorialMember() || isAdmin();
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['read']);
    }

    // ---------------------------
    // VOLUMES COLLECTION
    // ---------------------------
    match /volumes/{volumeId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }

    // ---------------------------
    // EDITORIAL BOARD COLLECTION
    // ---------------------------
    match /editorialBoard/{memberId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }

    // ---------------------------
    // INDEXING SERVICES COLLECTION
    // ---------------------------
    match /indexingServices/{serviceId} {
      allow read: if true;
      allow write: if isManagingEditor() || isAdmin();
    }

    // ---------------------------
    // SETTINGS COLLECTION
    // ---------------------------
    match /settings/submissionCounter {
      allow read: if true;
      allow write: if isServer();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if
        (isManagingEditor() || isAdmin()) &&
        settingId != 'submissionCounter';
    }
  }
}
